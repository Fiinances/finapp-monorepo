# =============================================================
# FINAPP BACKEND — Variáveis de Ambiente Sensíveis
# Valores não-sensíveis já estão em application.properties
# NUNCA commite este arquivo com valores reais.
# =============================================================

# -------------------------------------------------------------
# Banco de dados — Supabase (PostgreSQL)
# Disponível em: Supabase Dashboard > Project Settings > Database > Connection string
# ATENÇÃO: caracteres especiais na senha (ex: #, @, !) devem ser
# definidos como variável de ambiente pura — NÃO via arquivo .env,
# pois # é delimitador de comentário em parsers dotenv.
# -------------------------------------------------------------

QUARKUS_PROFILE=prod
QUARKUS_DATASOURCE_USERNAME=postgres
QUARKUS_DATASOURCE_PASSWORD=<SUBSTITUIR>
QUARKUS_DATASOURCE_JDBC_URL=jdbc:postgresql://db.<SUBSTITUIR: project-ref>.supabase.co:5432/postgres?sslmode=require

# -------------------------------------------------------------
# JWT — Supabase Auth
# Disponível em: Supabase Dashboard > Project Settings > API
# -------------------------------------------------------------
MP_JWT_VERIFY_ISSUER=https://<SUBSTITUIR: project-ref>.supabase.co/auth/v1
MP_JWT_VERIFY_PUBLICKEY_LOCATION=https://<SUBSTITUIR: project-ref>.supabase.co/auth/v1/jwks
