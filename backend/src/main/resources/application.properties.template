# =============================================================
# FINAPP BACKEND — Configuração Quarkus
# Copie este arquivo para application.properties e preencha
# os valores marcados com <SUBSTITUIR>
#
# Perfis disponíveis:
#   dev  → quarkus:dev (local). Banco local ou Supabase de dev.
#   prod → build nativo / Vercel. Banco Supabase de produção.
#   test → testes automatizados. H2 in-memory.
# =============================================================

# =============================================================
# PADRÃO (herdado por todos os perfis, salvo override)
# =============================================================

# Servidor
quarkus.http.port=8080
quarkus.http.cors=true
quarkus.http.cors.origins=*
quarkus.http.cors.methods=GET,POST,PUT,PATCH,DELETE,OPTIONS
quarkus.http.cors.headers=Authorization,Content-Type,Accept

# Banco de dados
quarkus.datasource.db-kind=postgresql

# Flyway
quarkus.flyway.locations=db/migration
quarkus.flyway.out-of-order=false

# Hibernate ORM — padrão seguro (nunca altera schema)
quarkus.hibernate-orm.database.generation=validate
quarkus.hibernate-orm.log.sql=false
quarkus.hibernate-orm.sql-load-script=no-file

# JWT
mp.jwt.verify.audiences=authenticated

# OpenAPI / Swagger UI — habilitado apenas fora de prod
quarkus.swagger-ui.always-include=false
quarkus.swagger-ui.path=/swagger
quarkus.smallrye-openapi.path=/openapi
mp.openapi.extensions.smallrye.info.title=Finapp API
mp.openapi.extensions.smallrye.info.version=1.0.0
mp.openapi.extensions.smallrye.info.description=API REST do Finapp — Controle Financeiro Pessoal

# Health Check
quarkus.smallrye-health.ui.always-include=true

# =============================================================
# PERFIL: dev (ambiente local — quarkus:dev)
# =============================================================

# Conexão com Supabase de desenvolvimento
%dev.quarkus.datasource.username=postgres
%dev.quarkus.datasource.password=<SUBSTITUIR: senha dev>
%dev.quarkus.datasource.jdbc.url=jdbc:postgresql://db.<SUBSTITUIR: project-ref-dev>.supabase.co:5432/postgres?sslmode=require
%dev.quarkus.datasource.jdbc.min-size=1
%dev.quarkus.datasource.jdbc.max-size=5

# Flyway dev — aplica migrations automaticamente
%dev.quarkus.flyway.migrate-at-start=true
%dev.quarkus.flyway.baseline-on-migrate=true
%dev.quarkus.flyway.baseline-version=2

# Hibernate dev — permite recriar schema localmente se necessário
# Troque para "drop-and-create" apenas quando quiser resetar o banco local
%dev.quarkus.hibernate-orm.database.generation=update
%dev.quarkus.hibernate-orm.log.sql=true

# JWT dev
%dev.mp.jwt.verify.issuer=https://<SUBSTITUIR: project-ref-dev>.supabase.co/auth/v1
%dev.mp.jwt.verify.publickey.location=https://<SUBSTITUIR: project-ref-dev>.supabase.co/auth/v1/jwks

# Swagger habilitado em dev
%dev.quarkus.swagger-ui.always-include=true

# =============================================================
# PERFIL: prod (Vercel / produção)
# =============================================================

# Credenciais via variáveis de ambiente (ver .env.example)
# QUARKUS_DATASOURCE_USERNAME, QUARKUS_DATASOURCE_PASSWORD,
# QUARKUS_DATASOURCE_JDBC_URL, MP_JWT_VERIFY_ISSUER,
# MP_JWT_VERIFY_PUBLICKEY_LOCATION

%prod.quarkus.datasource.jdbc.min-size=2
%prod.quarkus.datasource.jdbc.max-size=10

# Flyway prod — aplica apenas migrations pendentes, NUNCA recria schema
%prod.quarkus.flyway.migrate-at-start=true
%prod.quarkus.flyway.baseline-on-migrate=true
%prod.quarkus.flyway.baseline-version=2

# Hibernate prod — NUNCA drop-and-create
%prod.quarkus.hibernate-orm.database.generation=validate

# Swagger desabilitado em prod
%prod.quarkus.swagger-ui.always-include=false

# =============================================================
# PERFIL: test (testes automatizados — H2 in-memory)
# =============================================================

%test.quarkus.datasource.db-kind=h2
%test.quarkus.datasource.jdbc.url=jdbc:h2:mem:testdb;DB_CLOSE_DELAY=-1;MODE=PostgreSQL
%test.quarkus.flyway.enabled=false
%test.quarkus.hibernate-orm.database.generation=drop-and-create
%test.quarkus.hibernate-orm.log.sql=false
%test.mp.jwt.verify.issuer=https://test.issuer.example.com
